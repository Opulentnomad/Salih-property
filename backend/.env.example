# انسخه إلى .env ثم عدّل القيم (لا ترفع .env إلى Git)
NODE_ENV=production
PORT=3000
JWT_SECRET=                 # مطلوب في الإنتاج، 32 حرفًا على الأقل (openssl rand -hex 32)
DB_FILE=./data/safarna.db
ADMIN_EMAIL=                # يُنشأ مدير عند أول تشغيل إن حُدّد مع كلمة المرور
ADMIN_PASSWORD=
CORS_ORIGIN=                # اتركه فارغًا إن كانت الواجهة تُخدَّم من نفس الخادم
TRUST_PROXY=0               # اجعله 1 خلف Nginx/Cloudflare ليُحسب عنوان IP الحقيقي في تحديد المعدّل
